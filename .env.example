# Copy to .env — never commit real secrets.

TRACEIQ_ENV=dev
TRACEIQ_DATABASE_URL=postgresql+psycopg://traceiq_app:traceiq@localhost:55432/traceiq
TRACEIQ_MIGRATE_URL=postgresql+psycopg://traceiq:traceiq@localhost:55432/traceiq
TRACEIQ_DATA_DIR=./data
TRACEIQ_JWT_SECRET=change-me-in-production-use-long-random
TRACEIQ_REDACTION_KEY=change-me-32-byte-hex-or-passphrase
TRACEIQ_AUTH_MODE=local
TRACEIQ_MODEL=mock:mock-v1
TRACEIQ_NO_EXTERNAL_LLM=0
TRACEIQ_MODEL_ALLOWLIST=api.anthropic.com,api.openai.com,127.0.0.1,localhost
TRACEIQ_DEFAULT_BUDGET_USD=0.50
TRACEIQ_MAX_UPLOAD_BYTES=2147483648
TRACEIQ_LOG_LEVEL=INFO
